---
import '../styles/global.css';
const {title, description, noindex=false, schema=[], path=Astro.url.pathname}=Astro.props;
const origin=Astro.site?.origin||'https://findpublicapis.com';
const canonical=new URL(path,origin).href;
// Search results show about 60 characters of a title, so drop the brand suffix rather than lose the page name.
const fullTitle=`${title} | Find Public APIs`.length<=60?`${title} | Find Public APIs`:title;
// Snippets show about 160 characters: keep whole sentences when they fill most of that, else cut at a word.
function fit(text,max=160){if(text.length<=max)return text;let out='';for(const s of text.split(/(?<=[.!?])\s+/)){if((out?out+' '+s:s).length>max)break;out=out?out+' '+s:s;}return out.length>=90?out:text.slice(0,text.lastIndexOf(' ',max-1)).replace(/[,;:\s]+$/,'')+'…';}
const metaDescription=fit(description);
const globalSchema=[{'@context':'https://schema.org','@type':'WebSite','@id':origin+'/#website',name:'Find Public APIs',url:origin+'/',description:'A public API directory with documentation-reviewed guides and a browser-only API playground.'},{'@context':'https://schema.org','@type':'Organization','@id':origin+'/#organization',name:'Find Public APIs',url:origin+'/',logo:origin+'/favicon.svg'}];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="generator" content={Astro.generator}/><title>{fullTitle}</title><meta name="description" content={metaDescription}/><link rel="canonical" href={canonical}/><meta name="robots" content={noindex?'noindex,follow':'index,follow,max-image-preview:large'}/><meta name="theme-color" content="#164b3c"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta property="og:type" content="website"/><meta property="og:site_name" content="Find Public APIs"/><meta property="og:title" content={title}/><meta property="og:description" content={metaDescription}/><meta property="og:url" content={canonical}/><meta property="og:image" content={origin+'/social.png'}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/><meta name="referrer" content="no-referrer"/>{[...globalSchema,...schema].map(s=><script type="application/ld+json" set:html={JSON.stringify(s).replaceAll('<','\u003c')}/> )}</head><body><a class="skip" href="#main">Skip to content</a><header class="site-header"><div class="wrap nav"><a class="brand" href="/" aria-label="Find Public APIs home"><img src="/favicon.svg" alt="" width="32" height="32"/>Find Public APIs<span>.</span></a><nav aria-label="Main navigation"><a href="/library/" aria-current={path.startsWith('/library')?'page':undefined}>API library</a><a href="/playground/" aria-current={path==='/playground/'?'page':undefined}>Playground</a><a href="/guides/">Guides</a></nav><a class="nav-cta" href="/collections/docs-reviewed/">Start exploring <span>↗</span></a></div></header><slot/><footer class="site-footer"><div class="wrap footer-grid"><div><a class="brand" href="/">Find Public APIs<span>.</span></a><p>Less time finding an API.<br/>More time building something good.</p></div><div><strong>Explore</strong><a href="/library/">API library</a><a href="/collections/no-api-key/">No-key APIs</a><a href="/playground/">Request playground</a></div><div><strong>Make an informed choice</strong><a href="/guides/">Developer guides</a><a href="/about/">Sources & methodology</a><a href="/llms.txt">Machine-readable guide</a></div></div><div class="wrap footer-bottom"><span>Independent directory · No paid rankings</span><span>Catalog snapshot: 16 September 2026</span></div></footer></body></html>
