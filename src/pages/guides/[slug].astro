---
import Base from '../../layouts/Base.astro';
import {guides} from '../../lib/guides';
export function getStaticPaths(){return guides.map(guide=>({params:{slug:guide.slug},props:{guide}}));}
const {guide:g}=Astro.props;const origin=Astro.site.origin;
const schema=[{'@context':'https://schema.org','@type':'TechArticle',headline:g.title,description:g.description,datePublished:'2026-10-02',dateModified:'2026-10-02',author:{'@id':origin+'/#organization'},url:origin+`/guides/${g.slug}/`,citation:g.sources.map(s=>s[1])},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Guides',item:origin+'/guides/'},{'@type':'ListItem',position:2,name:g.title,item:origin+`/guides/${g.slug}/`}]}];
---
<Base title={g.title} description={g.description} schema={schema}><main id="main" class="wrap article-page"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/guides/">Guides</a><span>/</span><span>{g.label.toLowerCase()}</span></nav><article><header class="article-header"><div class="eyebrow">{g.label}</div><h1>{g.title}</h1><p class="lead">{g.intro}</p><p class="article-byline">By Endpoint editorial · Published 2 October 2026</p></header><div class="article-body">{g.sections.map(s=><section><h2>{s.title}</h2><p>{s.text}</p></section>)}{g.table&&<div class="table-scroll"><table><thead><tr>{g.table.headers.map(h=><th>{h}</th>)}</tr></thead><tbody>{g.table.rows.map(r=><tr>{r.map(c=><td>{c}</td>)}</tr>)}</tbody></table></div>}<section><h2>Further reading</h2><ul class="source-links">{g.sources.map(([name,url])=><li><a href={url} target="_blank" rel="noopener noreferrer">{name} ↗</a></li>)}</ul></section><div class="article-cta"><h2>Put it into practice.</h2><p>Start with a reviewed guide or test a request in the playground.</p><a class="button" href="/playground/">Open the playground ↗</a><a class="text-link" href="/collections/docs-reviewed/">Explore reviewed APIs →</a></div></div></article></main></Base>
