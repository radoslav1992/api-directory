---
import Base from '../../layouts/Base.astro';
import Playground from '../../components/Playground.astro';
import ApiCard from '../../components/ApiCard.astro';
import {apis,categorySlug,requestExample} from '../../lib/catalog';
import {buildRequest,snippets} from '../../lib/request.mjs';
export function getStaticPaths(){return apis.map(api=>({params:{slug:api.slug},props:{api}}));}
const {api:a}=Astro.props,checked=a.review==='reviewed',tested=!checked&&!!a.example,origin=Astro.site.origin;
const testedOn=tested&&new Date(a.example.checked+'T00:00:00Z').toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'});
const keyed=/YOUR_API_KEY/.test(a.endpoint+' '+a.header);
const related=apis.filter(b=>b.category===a.category&&b.slug!==a.slug).slice(0,3);
const example=requestExample(a);
let code='';if(checked||tested)code=snippets(buildRequest({url:a.endpoint,headers:Object.entries(example.headers),method:'GET'},{preview:true,reveal:true})).curl;
const questions=[{q:`What can I build with ${a.name}?`,a:a.use||a.description},{q:`Does ${a.name} need authentication?`,a:checked?`The reviewed example is listed as “${a.auth}”. ${a.note}`:tested?(keyed?`The example request needs a key: without one, the endpoint answered HTTP ${a.example.status} in our test on ${testedOn}. Get a key from the provider and paste it into the playground.`:`The example request worked without a key in our test on ${testedOn}. Other endpoints, higher limits, or commercial use may still need an account; check the provider’s documentation.`):`The source catalog reports “${a.auth}”. This has not been individually verified; check the provider’s documentation before relying on it.`},{q:`Can I call ${a.name} from a browser?`,a:(tested?(a.example.cors?'In our test the provider sent CORS headers that allow browser requests, so the playground should work. ':'In our test the provider did not send CORS headers, so browsers will probably block the playground request; use the cURL command instead. '):'')+'Browser access depends on the provider’s CORS policy for your origin, method, and headers. The playground makes a direct request and cannot bypass those restrictions.'}];
const schema=[{'@context':'https://schema.org','@type':checked?'TechArticle':'WebPage',headline:`${a.name} API guide`,name:`${a.name} API`,description:a.description,url:origin+`/apis/${a.slug}/`,...(checked?{dateModified:'2026-09-16',author:{'@id':origin+'/#organization'}}:{}),citation:a.docs},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'API library',item:origin+'/library/'},{'@type':'ListItem',position:2,name:a.category+' APIs',item:origin+`/categories/${categorySlug(a.category)}/`},{'@type':'ListItem',position:3,name:a.name,item:origin+`/apis/${a.slug}/`}]}];
---
<Base title={`${a.name} API — ${checked?'examples & playground':tested?'example & playground':'docs & reported access'}`} description={`${a.description} ${checked?'Auth, usage notes, request examples, and a browser playground.':tested?'Tested example request and a browser playground.':'Community listing with provider links; current requirements are unverified.'}`} noindex={!checked&&!tested} schema={schema}><main id="main" class="wrap detail-page"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/library/">Library</a><span>/</span><a href={`/categories/${categorySlug(a.category)}/`}>{a.category}</a><span>/</span><span>{a.name}</span></nav><section class="detail-hero"><div class:list={['api-mark','large',a.color]} aria-hidden="true">{a.mark}</div><div class="detail-title"><div class="eyebrow">{a.category} / API GUIDE</div><h1>{a.name}<span class="title-dot">.</span></h1><p>{a.description}</p><span class:list={['review-tag',checked&&'is-reviewed']}>{checked?'Documentation reviewed · 16 Sep 2026':tested?`Community listing · example tested ${testedOn}`:'Community listing · not individually reviewed'}</span></div><a class="button" href={a.docs} target="_blank" rel="noopener noreferrer">Official resource <span>↗</span></a></section><div class="detail-facts"><div><span>{checked?'AUTHENTICATION':tested?'AUTH FOR EXAMPLE':'REPORTED AUTH'}</span><strong>{a.auth}</strong></div><div><span>ACCESS / PRICING</span><strong>{checked?a.plan:'Check with provider'}</strong></div><div><span>EXAMPLE REQUEST</span><strong>{checked?'Included below':tested?'Tested · included below':'Bring your own endpoint'}</strong></div><div><span>REVIEW STATUS</span><strong>{checked?'Docs reviewed':'Catalog import'}</strong></div></div><div class="detail-layout"><article class="documentation"><section id="overview"><div class="eyebrow">THE OVERVIEW</div><h2>{checked?'A building block for your next idea.':'A starting point for your research.'}</h2><p>{a.use||a.description}</p>{tested&&<div class="notice"><strong>This entry has not been individually reviewed.</strong><p>The example request below was called on {testedOn} and responded{keyed?' (it needs your key to return data)':''}. Pricing, rate limits, and terms come from the provider; check its documentation before you build on it.</p></div>}{!checked&&!tested&&<div class="notice"><strong>This entry has not been individually reviewed.</strong><p>Authentication, HTTPS and CORS are source-reported. We have not supplied a guessed endpoint or example. Open the provider resource, choose a documented URL, then test it below.</p></div>}</section><section id="usage"><h2>Know before you build</h2><p>{a.note}</p><a class="text-link" href={a.docs} target="_blank" rel="noopener noreferrer">Check current provider documentation ↗</a></section>{(checked||tested)&&<section id="example"><h2>Your first request</h2>{checked?<p>Start with this documented example. Replace credential placeholders with your own test credentials. Browser execution depends on the provider’s CORS policy.</p>:<p>This request responded with HTTP {a.example.status} when we called it on {testedOn}.{keyed?' Replace YOUR_API_KEY with a key from the provider.':''} {a.example.cors?'The provider allows browser requests, so you can run it in the playground below.':'The provider did not send CORS headers, so the browser playground may be blocked; the cURL command works from a terminal.'}</p>}<div class="static-code"><div class="code-label">cURL <span>REQUEST EXAMPLE</span></div><pre><code>{code}</code></pre></div>{a.header?.startsWith('User-Agent:')&&<p class="notice">This provider requests an identifying User-Agent in server integrations. Browsers control that header; the browser playground omits it. Consult provider requirements before using a browser-only integration in production.</p>}</section>}<section id="questions"><h2>Practical questions</h2><div class="faq-list">{questions.map(q=><details><summary>{q.q}<span>+</span></summary><p>{q.a}</p></details>)}</div></section><section id="sources"><h2>Sources & confidence</h2><p>{checked?'Provider documentation was reviewed on 16 September 2026. This is not a live availability test or an endorsement.':tested?`This listing was imported on 16 September 2026. Its example request was called on ${testedOn}; that is a one-time check, not uptime monitoring.`:'This listing was imported on 16 September 2026. Import dates are not verification dates.'}</p><ul class="source-links">{a.sources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.name} ↗</a></li>)}</ul>{!checked&&<dl class="small-facts"><dt>HTTPS (reported)</dt><dd>{a.reported_https||'Unknown'}</dd><dt>CORS (reported)</dt><dd>{a.reported_cors||'Unknown'}</dd></dl>}<p class="subtle">Source catalogs can become outdated. <a href="/about/">Read our review and attribution policy.</a>{checked&&<> <a href={`/apis/${a.slug}.md`}>Plain-text guide ↗</a></>}</p></section></article><aside class="on-this-page"><div class="eyebrow">IN THIS GUIDE</div><a href="#overview">Overview</a><a href="#usage">Usage conditions</a>{(checked||tested)&&<a href="#example">Request example</a>}<a href="#questions">Practical questions</a><a href="#sources">Sources & confidence</a><a class="aside-play" href="#playground">Try a request ↗</a><div class="aside-note"><strong>Your request.<br/>Your browser.</strong><p>Credentials stay in the current page and are sent directly to the chosen provider.</p><a href="/guides/api-authentication/">How authentication works →</a></div></aside></div><Playground api={a}/>{related.length>0&&<section class="section related-section"><div class="section-heading"><h2>Keep exploring.</h2><a href={`/categories/${categorySlug(a.category)}/`} class="text-link">More {a.category.toLowerCase()} APIs ↗</a></div><div class="api-grid">{related.map(api=><ApiCard api={api}/>)}</div></section>}</main></Base>
