---
import Base from '../layouts/Base.astro';
import ApiCard from './ApiCard.astro';
import Pagination from './Pagination.astro';
import {categories,pageSize} from '../lib/catalog';
const {route:r}=Astro.props;
const selected=r.items.slice((r.current-1)*pageSize,r.current*pageSize);
const origin=Astro.site.origin;
const schema=[{'@context':'https://schema.org','@type':'CollectionPage',name:r.title,url:origin+r.path,description:r.description,mainEntity:{'@type':'ItemList',itemListElement:selected.map((a,i)=>({'@type':'ListItem',position:(r.current-1)*pageSize+i+1,name:a.name,url:origin+`/apis/${a.slug}/`}))}},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{ '@type':'ListItem',position:1,name:'Home',item:origin+'/'},{'@type':'ListItem',position:2,name:r.title,item:origin+r.base}]}];
---
<Base title={r.title+(r.current>1?` — page ${r.current}`:'')} description={r.current>1?`Page ${r.current} of ${Math.ceil(r.items.length/pageSize)}. ${r.description}`:r.description} path={r.path} schema={schema}><main id="main" class="wrap library-page"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>{r.title}</span></div><section class="library-heading"><div><div class="eyebrow">THE BUILDING BLOCKS</div><h1>{r.kind==='library'?<>Your next idea<br/>starts <em>here.</em></>:r.title}</h1><p>{r.description}</p></div><div class="library-count"><strong>{r.items.length.toLocaleString('en-US')}</strong><span>APIs to explore</span></div></section><form id="library-search" class="search-bar" role="search"><span aria-hidden="true">⌕</span><label class="sr-only" for="search">Search APIs</label><input id="search" type="search" placeholder="Search APIs, topics, or your next idea…" name="q" autocomplete="off"/><kbd>/</kbd><button type="submit" class="button">Search <span>→</span></button></form><div class="library-layout"><aside class="filters-panel"><div class="filter-heading">Refine your search</div><label class="check"><input id="filter-reviewed" type="checkbox"/> Docs reviewed only <span>32</span></label><label class="check"><input id="filter-no-key" type="checkbox"/> No API key reported</label><label class="check"><input id="filter-free" type="checkbox"/> Free access / tier</label><div class="filter-heading categories-heading">Categories</div><a class:list={['category-link',!r.category&&'selected']} href="/library/">All categories <span>50</span></a><label class="sr-only" for="category-search">Find a category</label><input class="category-input" id="category-search" type="search" placeholder="Find category…"/><div class="category-list">{categories.map(c=><a class:list={['category-link',r.category===c.name&&'selected']} href={`/categories/${c.slug}/`}>{c.name}<span>{c.count}</span></a>)}</div><p class="filter-note">A listing is a starting point. Always check current provider terms.</p></aside><section class="library-results" aria-label="API results"><div class="results-toolbar"><p id="result-summary" aria-live="polite">Showing {(r.current-1)*pageSize+1}–{Math.min(r.current*pageSize,r.items.length)} of {r.items.length.toLocaleString('en-US')} APIs</p><label class="sort">Sort <select id="sort"><option value="curated">Curated order</option><option value="name">Name A–Z</option></select></label></div><p id="library-status" class="subtle" role="status"></p><div id="api-grid" class="api-grid" data-base={r.base} data-initial-page={r.current} data-slugs={r.kind==='library'?'':JSON.stringify(r.items.map(a=>a.slug))}>{selected.map(a=><ApiCard api={a}/>)}</div><div id="empty-results" class="empty-state" hidden><span class="empty-icon">⌕</span><h2>No APIs found</h2><p>Try another search or remove a filter.</p><button id="reset-search" class="button secondary">Reset filters</button></div><Pagination base={r.base} total={r.items.length} current={r.current}/><div class="source-note"><span>◈</span><p><strong>Know what’s been checked.</strong> Reviewed guides include provider documentation and examples. Community listings contain reported information that may have changed. <a href="/about/">Our methodology →</a></p></div></section></div></main></Base>
<script>import '../scripts/library.js';</script>
