{
  "name": "endpoint-api-directory",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/import-catalogs.mjs && astro dev",
    "build": "node scripts/import-catalogs.mjs && astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-build.mjs",
    "build:cloudflare": "npm run build && npm run verify",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "astro": "7.3.5"
  },
  "devDependencies": {
    "wrangler": "4.146.0"
  }
}
